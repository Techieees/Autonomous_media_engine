# Autonomous Media Engine — copy to .env. Never commit .env.

APP_ENV=development
DRY_RUN=true
AUTONOMOUS_MODE=true
OWNER_TIMEZONE=Europe/Dublin
# AME_SCHEDULER_FAST=0
# AME_BOOTSTRAP_SIMULATION=0
# AME_BOOTSTRAP_OPEN_BROWSER=1
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
# Production: required dedicated credential KEK. Never reuse SECRET_KEY. Never commit the real value.
# AME_CREDENTIAL_KEK=
# AME_CREDENTIAL_KEK_ID=v1
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Production architecture remains PostgreSQL + Redis.
# Native V1 development/test: if Postgres is unreachable, AME uses data/ame.dev.db (SQLite).
# Production never falls back to SQLite. AME_FORCE_SQLITE is rejected when APP_ENV=production.
# Redis is optional locally; OAuth/locks degrade to an in-process store.
DATABASE_URL=postgresql+asyncpg://ame:ame@localhost:5432/ame
DATABASE_URL_SYNC=postgresql+psycopg://ame:ame@localhost:5432/ame
REDIS_URL=redis://localhost:6379/0
# AME_FORCE_SQLITE=0

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Hard owner caps. Director cannot raise these.
DAILY_AI_SPEND_LIMIT=5.00
DAILY_MEDIA_SPEND_LIMIT=2.00
MAX_CONTENT_PER_DAY=6
MAX_CONCURRENT_AGENT_RUNS=4
MAX_RESEARCH_CALLS_PER_CONTENT=4
MINIMUM_DAILY_CONTENT=0
TARGET_DAILY_CONTENT=2
MAXIMUM_DAILY_CONTENT=6
MAXIMUM_PER_PLATFORM=3
DAILY_COST_LIMIT=7.00

# LLM — leave empty to use deterministic development provider
LLM_PROVIDER=dev
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=dev-local
EMBEDDING_MODEL=dev-local

# TTS — dev uses local fallback
TTS_PROVIDER=dev
TTS_API_KEY=
TTS_VOICE=default

# Optional paid image generation
IMAGE_PROVIDER=none
IMAGE_API_KEY=

# Trend sources
HACKER_NEWS_ENABLED=true
RSS_FEEDS=https://hnrss.org/frontpage,https://feeds.bbci.co.uk/news/technology/rss.xml,https://www.theverge.com/rss/index.xml
YOUTUBE_DATA_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=autonomous-media-engine/0.1

# YouTube OAuth (owner bootstrap)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/youtube/callback

# Instagram / Meta
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/oauth/instagram/callback
INSTAGRAM_GRAPH_VERSION=v21.0

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/oauth/tiktok/callback

# Currency display
DEFAULT_CURRENCY=EUR
